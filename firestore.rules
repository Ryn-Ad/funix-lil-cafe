rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    // True for the owner, or for the named admin role.
    function hasRole(adminRole) {
      return isSignedIn() && role() in ['owner', adminRole];
    }
    function isOwner() {
      return isSignedIn() && role() == 'owner';
    }

    // Ryn, Zac, Vel — one doc per admin, created by hand in the console.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if false; // edit roles by hand in the console
    }

    // ---- Menus: anyone can read, only that corner's admin (or Ryn) edits.
    // Stock is changed by the server when an order is placed (the Admin
    // SDK bypasses these rules), so customers need no write access at all.
    match /saladItems/{id}    { allow read: if true; allow write: if hasRole('salad_admin'); }
    match /saladSauces/{id}   { allow read: if true; allow write: if hasRole('salad_admin'); }
    match /coffeeItems/{id}   { allow read: if true; allow write: if hasRole('coffee_admin'); }
    match /coffeeOptions/{id} { allow read: if true; allow write: if hasRole('coffee_admin'); }

    // ---- Private money data: Ryn only. Capital and owners are never
    // readable by customers or by the coffee admin.
    match /coffeeCosts/{id} {
      allow read, write: if isOwner();
    }
    // Per-order snapshot of revenue, capital and owner shares. Written
    // only by the server (api/submit-order.js); Ryn can read it.
    match /coffeeFinancials/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // ---- Open/closed overrides.
    match /settings/saladCorner {
      allow read: if true;
      allow write: if hasRole('salad_admin');
    }
    match /settings/coffeeCorner {
      allow read: if true;
      allow write: if hasRole('coffee_admin');
    }

    // ---- Orders: created ONLY by the server (api/submit-order.js), which
    // checks opening hours, prices and stock. Admins list, mark paid, delete.
    //
    // `get` (one order by its id) is open so a customer's "your orders" list
    // can show live paid status. Order ids are random 20-character strings
    // that only exist on the buyer's own device and the admin screens, so
    // they can't be guessed — and `list` (browsing ALL orders) stays
    // admin-only. An order holds a name, items and a total; never capital.
    match /saladOrders/{orderId} {
      allow create: if false;
      allow get: if true;
      allow list, update, delete: if hasRole('salad_admin');
    }
    match /coffeeOrders/{orderId} {
      allow create: if false;
      allow get: if true;
      allow list, update, delete: if hasRole('coffee_admin');
    }

    // Ryn's private coffee recipes.
    match /coffeeRecipes/{recipeId} {
      allow read, write: if isOwner();
    }
  }
}
